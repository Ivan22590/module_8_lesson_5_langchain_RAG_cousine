# Telegram
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token

# Pinecone
PINECONE_API_KEY=pcsk_your-pinecone-key
PINECONE_INDEX_NAME=rag-bot-index

# OpenAI-совместимый LLM-провайдер
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.proxyapi.ru/v1

# Необязательные настройки (значения по умолчанию — в config.py)
OPENAI_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Порог косинусного сходства для фильтрации дубликатов и действие при
# дубликате задаются ГЛОБАЛЬНЫМИ переменными в начале файла pinecone_manager.py:
#   COSINE_SIMILARITY_THRESHOLD, DUPLICATE_ACTION, DEDUPE_ENABLED
